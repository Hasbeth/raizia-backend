# Contraseña del panel de administración (cámbiala antes de compartir el equipo)
ADMIN_PASSWORD=cambia-esta-clave

# IA con Gemini (Google AI Studio: https://aistudio.google.com/apikey)
# Si GEMINI_API_KEY tiene valor, RAIZIA usa Gemini. Si está vacía, usa Ollama.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Forzar Ollama aunque haya clave: LLM_PROVIDER=ollama
LLM_PROVIDER=

# Ollama local (alternativa sin internet)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b

# Carpeta con raizia.db y files/. Vacía = data/ dentro del backend.
# En desarrollo local puede apuntar a ../raizia/data (o a una ruta absoluta).
RAIZIA_DATA_DIR=
# Para consultar la base original sin migraciones ni escrituras de SQLite:
# RAIZIA_DATA_DIR=../raizia/data
# RAIZIA_READ_ONLY=1
RAIZIA_READ_ONLY=0
