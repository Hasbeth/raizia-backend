# Forzar local ignora credenciales reales, deshabilita Gemini y descargas remotas del modelo.
# En Vercel: RAIZIA_MODO=produccion. En desarrollo/pruebas: local.
RAIZIA_MODO=local
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ADMIN_PASSWORD=
SESSION_SECRET=
CRON_SECRET=
FRONTEND_ORIGIN=
EMBED_PROVIDER=local
RAIZIA_EMBED_DISABLED=0
RAIZIA_PGLITE_DIR=data/pglite
# Si la extensión no está disponible como paquete, ruta local a vector.tar.gz:
RAIZIA_PGLITE_VECTOR=
RAIZIA_STORAGE_DIR=data/storage
RAIZIA_DATA_DIR=data
# Solo local. En Vercel dejar vacío: descarga de Hugging Face a /tmp/raizia-modelos.
RAIZIA_MODELOS_DIR=data/modelos
# none deshabilita generación; RAIZIA_MODO=local siempre la deshabilita.
LLM_PROVIDER=gemini
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
